# Copy to .env and fill in. .env is git-ignored.

# LLM used for targeted sentiment and moment summaries (Phase 5+).
LLM_API_KEY=
LLM_MODEL=

# Sent as the User-Agent on every request. Put a contact address in here so
# the free services we hit (Arctic Shift, MLB Stats API) can reach us.
MLB_FAN_PULSE_USER_AGENT=mlb-fan-pulse/0.1 (internal prototype; contact: you@example.com)

# Optional: override where data/raw and data/processed live.
# MLB_FAN_PULSE_DATA_DIR=
